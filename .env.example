# Copy to .env — every key is optional.

# Claude writes tailored cover letters, reads PDF resumes directly and builds
# your strategy. Without it the bot uses built-in templates.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=off      # disable server-side refusal fallbacks

# Telegram bot (npm run bot) and --telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=      # comma-separated Telegram user ids; empty = anyone

# Extra job boards with free API keys
ADZUNA_APP_ID=               # https://developer.adzuna.com  (19 countries)
ADZUNA_APP_KEY=
JOOBLE_API_KEY=              # https://jooble.org/api/about  (70+ countries)
REED_API_KEY=                # https://www.reed.co.uk/developers  (UK)

# Defaults
TARGET_COUNTRIES=DE,NL,GB,IE,SE,CA,AE
REPORT_LANG=fa
NATIONALITY=
TOP_JOBS=25
PITCH_COUNT=10
